{"workbook":"","regression":"// Excel 2007 실제 저장 구조. 가상 회원과 익명 코치만 사용하며 네트워크/DB 호출 없음.\nconst fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict');\nconst api=require('../90-Dashboard/shared/tennisnote-single-sheet-import.js');\nconst XLSX=require('../90-Dashboard/shared/vendor/xlsx.full.min.js');\nconst bytes=new Uint8Array(fs.readFileSync(path.join(__dirname,'fixtures/excel2007/saved-in-excel2007.xlsx')));\nfunction rewrite(part,fn){const z=XLSX.CFB.read(bytes,{type:'array'}),e=XLSX.CFB.find(z,'Root Entry/'+part);XLSX.CFB.utils.cfb_add(z,'Root Entry/'+part,new TextEncoder().encode(fn(new TextDecoder().decode(e.content))));return new Uint8Array(XLSX.CFB.write(z,{type:'array',fileType:'zip'}));}\nasync function run(){let checks=0;const check=(v,label)=>{assert(v,label);checks++;};\n const r=await api.readFile(bytes,XLSX);check(r.errors.length===0,'EXCEL2007_REIMPORT');check(r.rows.find(x=>x.rowNumber===3)?.status==='PARSED','COUPON_ROW_PARSED');check(r.rows.find(x=>x.rowNumber===2)?.status==='HOLD','INCOMPLETE_ROW_STILL_BLOCKED');\n const book='xl/workbook.xml';\n for(const transform of [x=>x.replaceAll('상품목록!',\"'상품목록'!\"),x=>x.replace(/<definedNames>([\\s\\S]*?)<\\/definedNames>/,(_,s)=>'<definedNames>'+s.match(/<definedName\\b[\\s\\S]*?<\\/definedName>/g).reverse().join('')+'</definedNames>')])check((await api.readFile(rewrite(book,transform),XLSX)).errors.length===0,'EQUIVALENT_NAMES_ACCEPTED');\n const mutations=[\n x=>x.replace('name=\"TN_CoachOptions\"','name=\"TN_ProductOptions\"'),\n x=>x.replace('name=\"TN_CoachOptions\"','name=\"Unexpected\"'),\n x=>x.replace('name=\"TN_CoachOptions\"','name=\"TN_CoachOptions\" localSheetId=\"0\"'),\n x=>x.replace('name=\"TN_CoachOptions\"','name=\"TN_CoachOptions\" hidden=\"1\"'),\n x=>x.replace('상품목록!$B$2:$B$5','[external.xlsx]상품목록!$B$2:$B$5'),\n x=>x.replace('상품목록!$B$2:$B$5','다른시트!$B$2:$B$5'),\n x=>x.replace('상품목록!$B$2:$B$5','상품목록!$B$2:$B$6'),\n x=>x.replace('상품목록!$B$2:$B$5','상품목록!B2:B5'),\n x=>x.replace('상품목록!$B$2:$B$5','상품목록!$B$2:$B$5,상품목록!$B$2:$B$5'),\n x=>x.replace('상품목록!$B$2:$B$5','INDIRECT(\"상품목록!B2:B5\")'),\n x=>x.replace('</definedNames>','<definedName name=\"TN_CoachOptions\">상품목록!$B$2:$B$5</definedName></definedNames>')];\n for(const change of mutations)check((await api.readFile(rewrite(book,change),XLSX)).errors.includes('PRODUCT_CATALOG_UNSAFE'),'UNSAFE_NAME_REJECTED');\n for(const change of [x=>x.replace('sqref=\"C2:C501\"','sqref=\"C2:C502\"'),x=>x.replace('showErrorMessage=\"1\"','showErrorMessage=\"0\"'),x=>x.replace('</worksheet>','<hyperlinks/></worksheet>')])check((await api.readFile(rewrite('xl/worksheets/sheet1.xml',change),XLSX)).errors.includes('PRODUCT_CATALOG_UNSAFE'),'UNSAFE_VALIDATION_REJECTED');\n console.log(JSON.stringify({result:'PASS',checks,network:0,productionWrites:0}));\n}\nrun().catch(e=>{console.error(e);process.exitCode=1});\n"}