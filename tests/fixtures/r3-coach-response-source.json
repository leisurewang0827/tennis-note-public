  "submitBinding": "  $(\"#coachSettlementReconciliationForm\")?.addEventListener(\"submit\", (event) => {\n    event.preventDefault();\n    void submitCoachSettlementReconciliation();\n  });",
  "form": "<form id=\"coachSettlementReconciliationForm\" class=\"coach-settlement-reconciliation-form\" hidden novalidate>\n              <fieldset>\n                <legend>확정 정산 응답</legend>\n                <label>\n                  <input type=\"radio\" name=\"coachSettlementReconciliationChoice\" value=\"acknowledged\" />\n                  <span><strong>확인했습니다</strong><small>표시된 월·횟수·정산액을 확인했습니다.</small></span>\n                </label>\n                <label>\n                  <input type=\"radio\" name=\"coachSettlementReconciliationChoice\" value=\"disputed\" />\n                  <span><strong>이의가 있습니다</strong><small>관리자가 확인할 짧은 사유를 남깁니다.</small></span>\n                </label>\n              </fieldset>\n              <label id=\"coachSettlementReconciliationReasonField\" class=\"coach-settlement-reconciliation-reason\" hidden>\n                <span>이의 사유 <small>2~240자</small></span>\n                <textarea id=\"coachSettlementReconciliationReason\" rows=\"3\" minlength=\"2\" maxlength=\"240\" placeholder=\"확인이 필요한 항목만 간단히 적어 주세요.\"></textarea>\n                <small>이름·전화번호 등 개인정보는 적지 마세요.</small>\n              </label>\n              <p id=\"coachSettlementReconciliationValidation\" class=\"coach-settlement-reconciliation-validation\" role=\"alert\" hidden></p>\n              <button id=\"coachSettlementReconciliationSubmit\" class=\"primary-button\" type=\"submit\" disabled>응답 저장</button>\n            </form>",
  "cssFragment": "/* Canonical private response controls: no new screen/navigation. */\n.coach-settlement-reconciliation-form {\n  overflow-wrap: anywhere;\n}\n\n.coach-settlement-reconciliation-form small {\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 700;\n  line-height: 1.5;\n}\n\n.coach-settlement-reconciliation-form {\n  display: grid;\n  gap: 12px;\n}\n\n.coach-settlement-reconciliation-form fieldset {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px;\n  margin: 0;\n  border: 0;\n  padding: 0;\n}\n\n.coach-settlement-reconciliation-form legend {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n.coach-settlement-reconciliation-form fieldset label {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  align-items: start;\n  gap: 9px;\n  min-height: 44px;\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  padding: 10px;\n  background: var(--paper);\n  cursor: pointer;\n}\n\n.coach-settlement-reconciliation-form fieldset label:has(input:checked) {\n  border-color: var(--green);\n  background: var(--soft-green);\n}\n\n.coach-settlement-reconciliation-form input[type=\"radio\"] {\n  width: 20px;\n  height: 20px;\n  margin: 1px 0 0;\n  accent-color: var(--green);\n}\n\n.coach-settlement-reconciliation-form fieldset span,\n.coach-settlement-reconciliation-reason {\n  display: grid;\n  gap: 3px;\n}\n\n.coach-settlement-reconciliation-reason textarea {\n  width: 100%;\n  min-height: 84px;\n  resize: vertical;\n  border: 1px solid var(--line);\n  border-radius: 9px;\n  padding: 10px 11px;\n  color: var(--ink);\n  background: var(--paper);\n  font: inherit;\n  font-size: 16px;\n  line-height: 1.5;\n}\n\n.coach-settlement-reconciliation-validation {\n  margin: 0;\n  color: var(--red);\n  font-size: 13px;\n  font-weight: 800;\n}\n\n.coach-settlement-reconciliation-submit,\n#coachSettlementReconciliationSubmit,\n.coach-settlement-reconciliation-retry {\n  min-height: 44px;\n}\n\n#coachSettlementReconciliationSubmit {\n  width: 100%;\n}\n\n#coachSettlementReconciliationSubmit:disabled {\n  border-color: var(--line);\n  color: var(--muted);\n  background: var(--wash);\n  box-shadow: none;\n  cursor: not-allowed;\n}\n\n.coach-settlement-reconciliation-retry {\n  justify-self: end;\n}\n\n@media (max-width: 1024px) {\n.coach-settlement-reconciliation-form fieldset {\n    grid-template-columns: 1fr;\n  }\n}\n",
  "registration": "existing classic script paths; tests/**/*.test.js; no new runtime script"
}
